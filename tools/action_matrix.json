  "cheat_codes": {
    "auth_pro": "adb shell am start -n com.nusa.kelontong/com.example.nusa_kasir.MainActivity --es action AUTH_PRO",
    "auth_lite": "adb shell am start -n com.nusa.kelontong/com.example.nusa_kasir.MainActivity --es action AUTH_LITE",
    "show_onboarding": "adb shell am start -n com.nusa.kelontong/com.example.nusa_kasir.MainActivity --es action ONBOARDING",
    "switch_variant": "adb shell am start -n com.nusa.kelontong/com.example.nusa_kasir.MainActivity --es variant {variant_id} --ez pro {is_pro}"
